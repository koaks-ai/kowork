{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/core/**/*",
    "src/preload/**/*",
    "packages/contracts/src/**/*",
    "packages/protocol/src/**/*",
    "packages/core/src/**/*",
    "packages/design-system/src/**/*",
    "tests/unit/**/*",
    "tests/integration/**/*",
    "tests/e2e/**/*",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node"]
  }
}
